# Environment variables for the Robotics Club site.
# Local: copy this file to .env.local.  Vercel: add each one under
# Project > Settings > Environment Variables, then redeploy.

# One-time key for creating the first admin account at /admin.
# Use 24+ random characters, e.g. from: openssl rand -hex 32
# After the admin account is created, delete this variable and redeploy.
ADMIN_SETUP_TOKEN=

# Public address of the site, with no trailing slash,
# e.g. https://robotics-club.vercel.app or your custom domain.
SITE_ORIGIN=

# Folder where the admin account, edited content, uploaded images and contact
# messages are saved. Must be a writable folder that is kept between deploys.
# NOTE: Vercel does not provide one, see the README / ask before relying on the admin there.
DATA_DIR=./storage
