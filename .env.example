# Environment variables for the Robotics Club site.
# Vercel: add each one under Project > Settings > Environment Variables, then redeploy.
# Local: copy this file to .env.local (the Supabase lines are optional locally; without
# them the site saves to files in DATA_DIR instead).

# --- Supabase (required on Vercel) ---------------------------------------------------
# First run supabase/setup.sql once in the Supabase SQL Editor.
# Both values are in Supabase: Project Settings > API.
SUPABASE_URL=
# The "service_role" secret key. It stays on the server and is never sent to browsers.
# Keep it secret: do not put it in any variable that starts with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin ---------------------------------------------------------------------------
# One-time key for creating the first admin account at /admin.
# Use 24+ random characters, e.g. from: openssl rand -hex 32
# After the admin account is created, delete this variable and redeploy.
ADMIN_SETUP_TOKEN=

# Exact public address you use to open the site, no trailing slash,
# e.g. https://robotics-club.vercel.app  (the admin rejects saves from other addresses).
# Leave empty to accept whatever address the site is opened on.
SITE_ORIGIN=

# --- Local development only ----------------------------------------------------------
# Folder used for storage when Supabase is not configured.
DATA_DIR=./storage
